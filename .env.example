# ============================================
# Supabase 配置（必须填写）
# ============================================

# 1. 去 https://supabase.com 创建项目
# 2. 项目设置 → API → 找到以下两个值
# 3. 替换下面的占位符

# 格式：https://[项目引用].supabase.co
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# 格式：eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh4eHh4eHh4eHgifQ.xxxxxxxxxxxxxxxx

# ============================================
# 示例（复制后替换）
# ============================================
# VITE_SUPABASE_URL=https://abc123xyz.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFiYzEyM3h5eiIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjQ1MDAwMDAwLCJleHAiOjE5NjA1NzYwMDB9.xxxxxxxxxxxxxx
